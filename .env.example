# Telegram bot token from @BotFather
TOKEN=123456789:AA...your_token...

# Vercel автоматически подставляет VERCEL_PROJECT_PRODUCTION_URL в production
# (без схемы, напр. "guard-bot.vercel.app"), поэтому WEBAPP_URL можно не задавать —
# схема https:// добавляется в коде. Он нужен только для ручного деплоя/локального теста:
# WEBAPP_URL=https://guard-bot.vercel.app

# Optional: Webhook URL. Defaults to WEBAPP_URL + "/webhook"
# WEBHOOK_URL=https://guard-bot.vercel.app/webhook