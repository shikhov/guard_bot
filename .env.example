# Telegram bot token from @BotFather
TOKEN=123456789:AA...your_token...

# Optional: URL вашего Worker для Cron-обработчика (scheduled).
# В fetch-запросах базовый URL определяется автоматически из request.url,
# поэтому эта переменная нужна только для перерегистрации вебхука по расписанию.
# Например: https://guard-bot.your-subdomain.workers.dev
# CF_WORKER_URL=https://guard-bot.your-subdomain.workers.dev